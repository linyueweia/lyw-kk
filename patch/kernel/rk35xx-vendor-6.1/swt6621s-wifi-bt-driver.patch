+static const char *skw_get_chip_id(u32 chip_type)
+{
+	switch (chip_type) {
+	case 0x100:
+		return "EA6621Q";
+
+	case 0x101:
+		return "EA6521QF";
+
+	case 0x102:
+		return "EA6621QT";
+
+	case 0x103:
+		return "EA6521QT";
+
+	case 0x200:
+		return "EA6316";
+
+	case 0x300:
+		return "SWT6621S";
+
+	default:
+		skw_err("Unsupport chip type: 0x%x\n", chip_type);
+		break;
+	}
+
+	return NULL;
+}
