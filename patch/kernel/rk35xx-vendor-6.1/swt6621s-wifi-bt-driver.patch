+int skw_key_idx(unsigned long bitmap)
+{
+	static u8 idx[] = {0xff, 0x00, 0x01, 0xff,
+			   0x02, 0xff, 0xff, 0xff,
+			   0x03, 0xff, 0xff, 0xff,
+			   0xff, 0xff, 0xff, 0xff};
+
+	return idx[bitmap & 0xf];
+}
