+static inline const char *skw_80211_mode_name(enum skw_rate_info_flags mode)
+{
+	static const char * const md_name[] = {"legacy", "ieee80211n", "ieee80211ac", "ieee80211ax"};
+
+	if (mode >= ARRAY_SIZE(md_name))
+		return "unknown";
+
+	return md_name[mode];
+}
