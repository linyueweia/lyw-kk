+
+	cur = ktime_get();
+	if(skw_sdio->boot_data==NULL ||(skw_sdio->service_state_map & (1<<BT_SERVICE)))
+		return ret;
+
+	skw_sdio_info("the ---debug---line:%d \n",__LINE__);
