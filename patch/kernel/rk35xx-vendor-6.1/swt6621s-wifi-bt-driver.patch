+	}
+	ret=skw_sdio->boot_data->bt_start();
+	skw_sdio->service_index_map = SKW_BT;
+	start_poll = ktime_get();
+	skw_sdio_info("the start service time =%lld", ktime_to_us(ktime_sub(start_poll, cur)));
