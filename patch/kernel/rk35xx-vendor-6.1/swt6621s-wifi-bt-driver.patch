+unsigned char skw_char2hex(char ch)
+{
+    unsigned char num = 0;
+    if(ch >= '0' && ch <= '9')
+    {
+        num = ch - 48;//0:48
+    }
+    else if(ch >= 'a' && ch <= 'f')
+    {
+        num = ch + 10 - 97;//a:97
+    }
+    else if(ch >= 'A' && ch <= 'F')
+    {
+        num = ch + 10 - 65;//A:65
+    }
+    return num;
+}
+EXPORT_SYMBOL_GPL(skw_char2hex);
