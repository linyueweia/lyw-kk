+enum SKW_BAND {
+	SKW_BAND_2GHZ,
+	SKW_BAND_5GHZ,
+	SKW_BAND_6GHZ,
+	SKW_BAND_60GHZ,
+
+	SKW_BAND_INVALD,
+};
+
+static inline enum SKW_BAND to_skw_band(enum nl80211_band band)
+{
+	enum SKW_BAND new_band;
+
+	switch (band) {
+	case NL80211_BAND_2GHZ:
+		new_band = SKW_BAND_2GHZ;
+		break;
+
+	case NL80211_BAND_5GHZ:
+		new_band = SKW_BAND_5GHZ;
+		break;
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 4, 0)
+	case NL80211_BAND_6GHZ:
+		new_band = SKW_BAND_6GHZ;
+		break;
+#endif
+
+	default:
+		new_band = SKW_BAND_INVALD;
+		break;
+	}
+
+	return new_band;
+}
+
+static inline enum nl80211_band to_nl80211_band(enum SKW_BAND skw_band)
+{
+	enum nl80211_band band;
+
+	switch (skw_band) {
+	case SKW_BAND_2GHZ:
+		band = NL80211_BAND_2GHZ;
+		break;
+
+	case SKW_BAND_5GHZ:
+		band = NL80211_BAND_5GHZ;
+		break;
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 4, 0)
+	case SKW_BAND_6GHZ:
+		band = NL80211_BAND_6GHZ;
+		break;
+#endif
+
+	default:
+		band = NUM_NL80211_BANDS;
+	}
+
+	return band;
+}
