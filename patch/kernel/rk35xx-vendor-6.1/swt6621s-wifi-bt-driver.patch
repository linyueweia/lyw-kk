+ssize_t skw_file_write(struct file *fp, const void *buf, size_t len)
+{
+#ifdef FILE_RW_ENABLE
+    ssize_t res_len = 0;
+    loff_t pos = fp->f_pos;
+    mm_segment_t fs = skwbt_get_fs();
+    res_len = skw_write(fp, buf, len, &pos);
+    fp->f_pos = pos;
+    skwbt_set_fs(fs);
+
+    return res_len;
+#else
+    return 0;
+#endif
+
+}
+EXPORT_SYMBOL_GPL(skw_file_write);
