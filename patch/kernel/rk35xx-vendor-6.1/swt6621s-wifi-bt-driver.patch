+#ifdef CONFIG_PM
+        .suspend   = skw_usb_io_suspend,
+        .resume    = skw_usb_io_resume,
+        .reset_resume = skw_usb_io_reset_resume,
+#endif	
+	.pre_reset = skw_usb_io_pre_reset,
+	.post_reset = skw_usb_io_post_reset,
+	.id_table = skw_usb_io_id_table,
+	.supports_autosuspend = 1,
+};
