+static enum hrtimer_restart skw_tx_timer_callback(struct hrtimer *timer)
+{
+	struct skw_core *skw = container_of(timer, struct skw_core, timer);
+
+	queue_work(skw->tx_wq, &skw->tx_worker);
+
+	return HRTIMER_NORESTART;
+}
