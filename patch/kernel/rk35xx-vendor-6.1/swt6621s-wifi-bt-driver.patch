+char *skw_strchr(char *str, const char ch)
+{
+    char *ptr = str;
+
+    while((ptr != NULL) && ((*ptr) != '\r') && ((*ptr) != '\n') && ((*ptr) != 0))
+    {
+        if((*ptr) == ch)
+        {
+            return ptr;
+        }
+        ptr ++;
+    }
+    return NULL;
+}
+
+int skw_strlen(char *str)
+{
+    char *ptr = str;
+    int str_len = 0;
+    while((ptr != NULL) && ((*ptr) != '\r') && ((*ptr) != '\n') && ((*ptr) != 0))
+    {
+        ptr ++;
+        str_len ++;
+    }
+    return str_len;
+}
+EXPORT_SYMBOL_GPL(skw_strlen);
