+	case NL80211_IFTYPE_STATION:
+	case NL80211_IFTYPE_P2P_CLIENT:
+		// if (iface->sta.sm.state !=  SKW_STATE_NONE)
+			//skw_disconnect(iface->wdev.wiphy, iface->ndev,
+			//		WLAN_REASON_DEAUTH_LEAVING);
+		break;
+
+	case NL80211_IFTYPE_AP:
