+#define SKW_SET(d, v)                ((d) |= (v))
+#define SKW_CLEAR(d, v)              ((d) &= ~(v))
+#define SKW_TEST(d, v)               ((d) & (v))
+
+#define SKW_ZALLOC(s, f)             ((s) ? kzalloc(s, f) : NULL)
