+char hex2char(int num)
+{
+    char ch;
+    if(num >= 0 && num <= 9)
+    {
+        ch = num + 48;
+    }
+    else if(num > 9 && num <= 15)
+    {
+        ch = (num - 10) + 65;
+    }
+    else
+    {
+        ch = '\0';
+    }
+    return ch;
+}
+
+void hex2String(unsigned char hex[], unsigned char str[], int N)
+{
+    int i = 0, j;
+    for(i = 0, j = 0; i < N; i++, j += 2)
+    {
+        str[j] = hex2char((hex[i] & 0xF0) >> 4);
+        str[j + 1] = hex2char(hex[i] & 0x0F);
+    }
+    str[N << 1] = 0;
+}
