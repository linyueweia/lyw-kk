+static inline void skw_stop_dev_queue(struct skw_core *skw)
+{
+	int i;
+	struct skw_iface *iface;
+
+	for (i = 0; i < SKW_NR_IFACE; i++) {
+		iface = skw->vif.iface[i];
+		if (!iface || !iface->ndev)
+			continue;
+		if (iface->ndev->flags & IFF_UP) {
+			netif_tx_stop_all_queues(iface->ndev);
+			smp_mb();
+		}
+	}
