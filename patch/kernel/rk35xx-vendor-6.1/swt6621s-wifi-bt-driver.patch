+/* for 11w */
+static int skw_set_default_mgmt_key(struct wiphy *wiphy, struct net_device *dev,
+				int link_id, u8 key_index)
+{
+	skw_dev_dbg(dev, "key index: %d\n", key_index);
+
+	return 0;
