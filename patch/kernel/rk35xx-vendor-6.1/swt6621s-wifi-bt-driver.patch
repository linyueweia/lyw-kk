+static inline const char *skw_width_name(enum SKW_CHAN_BW_INFO state)
+{
+	static const char * const wd_name[] = {"20M", "40M", "80M",
+					"80+80M", "160M"};
+
+	if (state >= ARRAY_SIZE(wd_name))
+		return "unknown";
+
+	return wd_name[state];
+}
