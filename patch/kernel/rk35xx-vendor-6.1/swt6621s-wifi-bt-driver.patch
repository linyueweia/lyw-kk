+static int skw_cmd_close_dev(struct wiphy *wiphy, int dev_id)
+{
+	skw_dbg("dev id: %d\n", dev_id);
+
+	return skw_msg_xmit(wiphy, dev_id, SKW_CMD_CLOSE_DEV, NULL, 0, NULL, 0);
+}
