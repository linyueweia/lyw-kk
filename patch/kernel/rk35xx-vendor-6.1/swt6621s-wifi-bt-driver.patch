+	str = "byte";
+	ret += sprintf(&buffer[ret], "max_pkg_size:\t%u (%s)\n", max_pac_size, str);
+	ret += sprintf(&buffer[ret], "skw_sdio_blk_size:\t%u (%s)\n", skw_sdio_blk_size, str);
+	ret += sprintf(&buffer[ret], "max_tx_pkg_cnt:\t%u\n", MAX_PAC_COUNT);
