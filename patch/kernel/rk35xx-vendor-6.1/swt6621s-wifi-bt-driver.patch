+        struct sv6160_platform_data *pdata = (struct sv6160_platform_data *)skwbt_log_pdata;
+
+        if(pdata->bluetooth_log_disable)
+        {
+            pdata->bluetooth_log_disable(is_open > 0 ? 0 : 1);
+        }
+        SKWBT_INFO("skwbt_log_open, is_open:%d", is_open);
+    }
+}
