+static int skw_rx_reorder_timeout_open(struct inode *inode, struct file *file)
+{
+	// return single_open(file, skw_tx_time_show, inode->i_private);
+	return single_open(file, skw_rx_reorder_timeout_show, skw_pde_data(inode));
+}
+
+static ssize_t skw_rx_reorder_timeout_write(struct file *fp, const char __user *buf,
+		size_t len, loff_t *offset)
+{
+	int i;
+	char cmd[32] = {0};
+	unsigned int timeout = 0;
+	struct skw_core *skw = skw_pde_data(file_inode(fp));
+
+	for (i = 0; i < 32; i++) {
+		char c;
+
+		if (get_user(c, buf))
+			return -EFAULT;
+
+		if (c == '\n' || c == '\0')
+			break;
+
+		if (isdigit(c) != 0)
+			cmd[i] = c;
+		else {
+			skw_warn("set fail, not number\n");
+			return -EFAULT;
+		}
+
+		buf++;
+	}
+
+	if (kstrtouint(cmd, 10, &timeout))
+		return -EFAULT;
+
+	skw->config->global.reorder_timeout = timeout;
+
+	return len;
+}
