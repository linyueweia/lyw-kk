+void skwbt_log_port_release_queue(void)
+{
+    struct sk_buff *skb;
+    if(skwbt_log_port_info != NULL)
+    {
+        while((skb = skb_dequeue(&skwbt_log_port_info->skwbt_rx_q)))
+        {
+            kfree_skb(skb);
+        }
+    }
+}
