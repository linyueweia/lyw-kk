+	return 0;
+}
+
+static ssize_t user_dump_read(struct file *fp, char __user *buf, size_t count, loff_t *pos)
+{
+	ssize_t ret = skw_ucom_dump_from_buffer(buf, count, pos);
+	if (ret == 0)
+		dump_log_size = 0;
+	return ret;
+
+}
