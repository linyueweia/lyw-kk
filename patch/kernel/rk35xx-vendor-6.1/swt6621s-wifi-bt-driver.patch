+{
+	skw_log(SKW_STATE, "[%s] inst: %d, %s -> %pM, state: %s -> %s\n",
+		SKW_TAG_STATE, sm->inst, skw_iftype_name(sm->iface_iftype),
+		sm->addr, skw_state_name(sm->state), skw_state_name(state));
+
+	sm->state = state;
