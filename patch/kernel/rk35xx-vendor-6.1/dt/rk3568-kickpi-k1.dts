		/* 6.1 树把 sdhci@/dwmmc@ 改名成 mmc@（alias 必须跟节点改名走，否则 dtc 报 alias_paths） */
		mmc0 = "/mmc@fe310000";
		mmc1 = "/mmc@fe2b0000";
		mmc2 = "/mmc@fe2c0000";
		mmc3 = "/mmc@fe000000";
