	 * "rockchip,rk3568-kickpi-k1"（5.10 实机是 "...K1A Board" / "...kickpi-k1a"）。
	 * 保留 kickpi,k1 作为次级 compatible，兼容既有 userspace / 社区仓库的匹配。 */
	model = "Rockchip RK3568 KICKPI K1 Board";
	compatible = "rockchip,rk3568-kickpi-k1", "kickpi,k1", "rockchip,rk3568";

