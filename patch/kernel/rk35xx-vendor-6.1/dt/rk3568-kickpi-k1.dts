			cpu-idle-states = <0x04>;
			#cooling-cells = <0x02>;
			dynamic-power-coefficient = <0xbb>;
			cpu-supply = <&{/i2c@fdd40000/tcs4525@1c}>;
		};
		cpu@100 {
