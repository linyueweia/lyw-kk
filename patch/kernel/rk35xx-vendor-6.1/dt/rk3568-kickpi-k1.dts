&pwm5 {
	pinctrl-names = "active";
	pinctrl-0 = <&{/pinctrl/pwm5/pwm5-pins}>;
	status = "disabled";
};

&saradc {
	status = "okay";
	vref-supply = <&vcca_1v8>;
};

&combphy0_us {
	status = "okay";
};

&combphy1_usq {
	status = "okay";
};

&combphy2_psq {
	status = "okay";
};

&usb2phy0 {
	#clock-cells = <0x00>;
	status = "okay";
};

&usb2phy1 {
	#clock-cells = <0x00>;
	status = "okay";
};

&pcie30phy {
	status = "okay";
};

&mpp_srv {
	compatible = "rockchip,mpp-service";
	rockchip,taskqueue-count = <0x06>;
	rockchip,resetgroup-count = <0x06>;
	status = "okay";
};

&bus_npu {
	compatible = "rockchip,rk3568-bus";
	rockchip,busfreq-policy = "clkfreq";
	status = "okay";
	bus-supply = <&vdd_logic>;
	pvtm-supply = <&vdd_cpu>;
};

&usbdrd30 {
	status = "okay";
};

/* 6.1 SoC dtsi 把该子节点命名为 usb@fcc00000（label usbdrd_dwc3，rk356x.dtsi:587）；
 * 之前写成 dwc3@fcc00000 会生成孤儿节点，真控制器保持 dtsi 默认 disabled → OTG 无节点。 */
&usbdrd_dwc3 {
	dr_mode = "otg";
	status = "okay";
	phys = <&u2phy0_otg>;
	phy-names = "usb2-phy";
	extcon = <&usb2phy0>;
	maximum-speed = "high-speed";
	snps,dis_u2_susphy_quirk;
};

&usbhost30 {
	status = "okay";
};

/* 6.1 SoC dtsi: usbhost_dwc3: usb@fd000000（rk356x.dtsi:621） */
&usbhost_dwc3 {
	dr_mode = "host";
	status = "okay";
	phys = <&{/usb2-phy@fe8a0000/host-port} &combphy1_usq 0x04>;
	phy-names = "usb2-phy\0usb3-phy";
};

/* ===== 实机 status 对齐（19 处回归修复）=====
 * 实机 KICKPI K1 的 /sys/firmware/fdt（kickpi-k1a-live.dts）里下列 19 处
 * 全部 status = "okay"，而本 DTS 只 include rk3568.dtsi、未做覆写，
 * 于是继承 6.1 dtsi 的 "disabled" -> 编出来的镜像里这些节点全是关的。
 * 回归来源：60c7b7b 的实机转写带这批覆写，bc739c5（标签退化修复）与
 * b49a9d6（转写器结构化重写）两轮重新生成时整批丢失，1727042 只补了
 * 视频/图像/NPU 集群，仍漏这 19 处。
 * 这里按实机原值回填：只写 status，外加实机确有、且 6.1 dtsi 里不可能
 * 自己知道的板级 supply（USB5V、GPU/DDR 供电、PMU IO 电压域）。 */

/* DDR devfreq（实机 dfi/dmc = okay） */
&dfi {
	status = "okay";
};

&dmc {
	status = "okay";
	center-supply = <&vdd_logic>; /* 实机 dmc.center-supply -> RK809 DCDC_REG1 = vdd_logic */
};

/* GPU（实机 gpu@fde60000 = okay） */
&gpu {
	status = "okay";
	mali-supply = <&vdd_gpu>; /* 实机 gpu.mali-supply -> RK809 DCDC_REG2 = vdd_gpu */
};

/* 摄像头/ISP 集群（实机 csi2-dphy-hw / csi2-dphy0 / rkisp / rkisp_mmu / rkisp-vir0 = okay） */
&csi2_dphy_hw {
	status = "okay";
};

&csi2_dphy0 {
	status = "okay";
};

&rkisp {
	status = "okay";
};

&rkisp_mmu {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";
	port {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		isp0_in: endpoint@0 {
			reg = <0x00>;
			remote-endpoint = <&csidphy_out>;
		};
	};
};

/* 视频硬解（实机 vdpu@fdea0400 = okay，compatible rockchip,vpu-decoder-v2 与实机逐字相同） */
&vdpu {
	status = "okay";
};

/* NAND（实机 nandc@fe330000 = okay，6.1 树同名节点标签为 nandc0） */
&nandc0 {
	status = "okay";
};

/* 红外遥控 PWM（实机 pwm@fe6e0030 = okay，6.1 树标签 pwm7，dtsi 自带 pwm7-pins） */
