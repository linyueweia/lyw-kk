// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * KICKPI K1 (V1.2, RK3568B2) —— iNextOS/Armbian 板级设备树
 *
 * 2026-10-13 重写：本文件此前是厂商 5.10 DTS 的 85KB 全量转写（整棵 SoC 树展开
 * 覆盖在 6.1 dtsi 之上），实机表现为内核在极早期静默死亡（u-boot 正常、
 * Starting kernel 后零输出、灯全灭）。对照两条已验证成功线重写为官方模式：
 *   · 结构模板 = lyw-OS（T68M，同框架同内核实机成功）：#include "rk3568.dtsi"
 *     官方打底 + 最小板级覆盖；
 *   · 板级数值  = lyw-kf（飞牛线，本板实机验证）与厂商原厂 DTS 取证，
 *     全部标注来源；与 T68M 的板级差异单独注明。
 * 不再包含：厂商全量 SoC 树 / reserved-memory / fiq-debugger / 厂商私有
 * platdata 节点（bluetooth-platdata、wlan-platdata 等，6.1 内核无驱动）。
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include "rk3568.dtsi"

/ {
	model = "KICKPI K1";
	compatible = "kickpi,k1", "rockchip,rk3568";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		mmc0 = &sdhci;
		mmc1 = &sdmmc0;

		led-boot = &work_led;
		led-failsafe = &work_led;
		led-running = &work_led;
		led-upgrade = &work_led;
	};

	/* 串口控制台：ttyS2 @1500000（本板 console，README 实测值）。
	   此前转写版缺失 chosen → 裸 earlycon 失效、console 无 DT 出处。 */
	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* 厂商原厂 DTS：按键走 SARADC，keyup 1800000、vol-up 1750（数值取自厂商实机） */
	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		vol-up-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <1750>;
		};
	};

	/* 工作灯 = gpio0 PD5 heartbeat（lyw-kf 实机 DTS 原值；T68M 是 gpio4 PC6，
	   属板级差异）。风扇 = gpio0 PD6 GPIO 直驱非 PWM（kickpi-k1.csc 注释 +
	   厂商实机 DTS），恒转。 */
	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&work_led_pin>, <&fan_pin>;

		work_led: led-work {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PD5 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};

		fan: led-fan {
			gpios = <&gpio0 RK_PD6 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};

	/* WiFi(SWT6621S) SDIO 上电时序：lyw-kf R1–R5 五轮实机定论 ——
	   脚必须 PD5、flag 必须 ACTIVE_LOW、延时 1000ms（200ms 会失败）。
	   与 T68M 的板级差异（T68M 是 PD5+ACTIVE_LOW+200ms AIC8800）。 */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk809 1>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		post-power-on-delay-ms = <1000>;
		reset-gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_LOW>;
	};

	vcc12v_dcin: vcc12v-dcin-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc3v3_sys: vcc3v3-sys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_sys: vcc5v0-sys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_usb: vcc5v0-usb-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	/* USB 供电脚（lyw-kf 实机 DTS 原值）：host=GPIO0 PA6、otg=GPIO0 PA5，高有效 */
	vcc5v0_usb_host: vcc5v0-usb-host-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_usb_host_en>;
		regulator-name = "vcc5v0_usb_host";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_usb>;
	};

	vcc5v0_usb_otg: vcc5v0-usb-otg-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_usb_otg_en>;
		regulator-name = "vcc5v0_usb_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_usb>;
	};

	vcc3v3_pcie: vcc3v3-pcie-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc3v3_sys>;
	};
};

&combphy0_us {
	status = "okay";
};

&combphy1_usq {
	status = "okay";
};

&combphy2_psq {
	/* SATA（README 实机取证：ata1 控制器在线；combphy2 供 SATA2） */
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
};

/* 双千兆：phy-mode="rgmii" + MAC 侧 tx/rx_delay 数值全部为本板实机值
   （lyw-kf PORTING §3.7 三方一致表 + 厂商原厂 DTS）。
   ⚠ 与 T68M 的板级差异：T68M 是 rgmii-id 且无 tx/rx_delay 属性（延迟全在
   PHY 侧），K1 必须用 rgmii + 显式 delay —— 数值动错会丢包（曾实测 1400B
   丢 90%）。phy-mode 改 "rgmii-id" 会死（PORTING 反面教训）。 */
&gmac0 {
	assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;
	clock_in_out = "output";
	phy-mode = "rgmii";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim
		     &gmac0_tx_bus2
		     &gmac0_rx_bus2
		     &gmac0_rgmii_clk
		     &gmac0_rgmii_bus>;
	/* 第二 PHY 复位：**GPIO2_D3**（控制器 /pinctrl/gpio@fe750000 = gpio2，pin 0x1b = 27）active-low，MAC 侧单持有。
	   ⚠ 历史 bug（2026-10-14 实机定案）：此处原先误写成 <&gpio3 RK_PB3>（= gpio3 pin 11）——
	   按到了完全不同的控制器与引脚 → 第二 PHY 一直处于复位 → 其 MDIO 总线地址 0/1/2 全无应答
	   → stmmac 报 "Cannot attach to PHY (error: -19)"，整口不可用（第一口不受影响，因为它的
	   reset 是同为 gpio3 pin 7 = GPIO3_A7，两侧一致）。
	   铁证（同一块板、同一颗 MAE0621A，双口可用的飞牛线 DTB 对照）：
	     ethernet@fe2a0000：KF = gpio@fe750000(gpio2) pin 27  ｜ KK 原值 = gpio@fe760000(gpio3) pin 11 ✗
	     ethernet@fe010000：KF = gpio@fe760000(gpio3) pin 7   ｜ KK 原值 = gpio@fe760000(gpio3) pin 7 ✓
	   即"第一口好、第二口死"的全部差异就在这一行；原注释里写的 fe750000 pin 0x1b 才是对的，
	   代码没跟上（注释与代码自相矛盾是这次排障最耗时的干扰项）。 */
	snps,reset-gpio = <&gpio2 RK_PD3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	tx_delay = <0x21>;
	rx_delay = <0x3c>;
	phy-handle = <&rgmii_phy0>;
	status = "okay";
};

&gmac1 {
	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;
	clock_in_out = "output";
	phy-mode = "rgmii";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1m1_miim
		     &gmac1m1_tx_bus2
		     &gmac1m1_rx_bus2
		     &gmac1m1_rgmii_clk
		     &gmac1m1_rgmii_bus>;
	/* 厂商实机：reset = gpio3 PA7（fe760000 pin 0x07）active-low */
	snps,reset-gpio = <&gpio3 RK_PA7 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	tx_delay = <0x2f>;
	rx_delay = <0x39>;
	phy-handle = <&rgmii_phy1>;
	status = "okay";
};

&mdio0 {
	/* 占位 PHY：GMAC4 的 stmmac_mdio_reset 缺"复位后补一个 MDC 时钟"的
	   dummy read（PORTING 坑⑤），PHY ID 首帧会被读成 0xffff4411 导致
	   Maxio 驱动永不匹配。在 phy@0 之前放一个占位节点让扫描先走一帧，
	   phy@0 即读到正确 ID。此为本板必需（T68M/RTL8211F 无此问题）。 */
	ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};

	rgmii_phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&mdio1 {
	ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};

	rgmii_phy1: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&gpu {
	mali-supply = <&vdd_gpu>;
	status = "okay";
};

&hdmi {
	avdd-0v9-supply = <&vdda0v9_image>;
	avdd-1v8-supply = <&vcca1v8_image>;
	/* HDMI PHY 校准表：照抄同内核树官方 EVB（rk3568-evb.dtsi），不自造。 */
	rockchip,phy-table =
		<92812500  0x8009 0x0000 0x0270>,
		<165000000 0x800b 0x0000 0x026d>,
		<185625000 0x800b 0x0000 0x01ed>,
		<297000000 0x800b 0x0000 0x01ad>,
		<594000000 0x8029 0x0000 0x0088>,
		<000000000 0x0000 0x0000 0x0000>;
	status = "okay";
};

&hdmi_in_vp0 {
	status = "okay";
};

&hdmi_in_vp1 {
	status = "disabled";
};

/* BSP display-subsystem 的 route-hdmi 默认 disabled+connect=vp1，
   不覆盖则 HDMI 无路由（T68M 实测 drm_bridge_attach -22 的教训）。 */
&route_hdmi {
	status = "okay";
	connect = <&vp0_out_hdmi>;
};

&hdmi_sound {
	status = "okay";
};

&i2c0 {
	status = "okay";

	/* vdd_cpu：厂商原厂 DTS = fan53555（@0x1c，712000–1390000，
	   init 900000、ramp 2300）。T68M 同位置是 tcs4525 —— 板级差异。 */
	vdd_cpu: regulator@1c {
		compatible = "fan53555-reg";
		reg = <0x1c>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <712000>;
		regulator-max-microvolt = <1390000>;
		regulator-init-microvolt = <900000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	rk809: pmic@20 {
		compatible = "rockchip,rk809";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
		assigned-clocks = <&cru I2S1_MCLKOUT_TX>;
		assigned-clock-parents = <&cru CLK_I2S1_8CH_TX>;
		#clock-cells = <1>;
		clock-names = "mclk";
		clocks = <&cru I2S1_MCLKOUT_TX>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>, <&i2s1m0_mclk>;
		system-power-controller;
		#sound-dai-cells = <0>;
		wakeup-source;

		vcc1-supply = <&vcc3v3_sys>;
		vcc2-supply = <&vcc3v3_sys>;
		vcc3-supply = <&vcc3v3_sys>;
		vcc4-supply = <&vcc3v3_sys>;
		vcc5-supply = <&vcc3v3_sys>;
		vcc6-supply = <&vcc3v3_sys>;
		vcc7-supply = <&vcc3v3_sys>;
		vcc8-supply = <&vcc3v3_sys>;
		vcc9-supply = <&vcc3v3_sys>;

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-name = "vdd_logic";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_gpu: DCDC_REG2 {
				regulator-name = "vdd_gpu";
				regulator-always-on;
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vdd_npu: DCDC_REG4 {
				regulator-name = "vdd_npu";
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_1v8: DCDC_REG5 {
				regulator-name = "vcc_1v8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v9_image: LDO_REG1 {
				regulator-name = "vdda0v9_image";
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <950000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda_0v9: LDO_REG2 {
				regulator-name = "vdda_0v9";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v9_pmu: LDO_REG3 {
				regulator-name = "vdda0v9_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vccio_acodec: LDO_REG4 {
				regulator-name = "vccio_acodec";
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-name = "vccio_sd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc3v3_pmu: LDO_REG6 {
				regulator-name = "vcc3v3_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcca_1v8: LDO_REG7 {
				regulator-name = "vcca_1v8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcca1v8_pmu: LDO_REG8 {
				regulator-name = "vcca1v8_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vcca1v8_image: LDO_REG9 {
				regulator-name = "vcca1v8_image";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_3v3: SWITCH_REG1 {
				regulator-name = "vcc_3v3";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc3v3_sd: SWITCH_REG2 {
				regulator-name = "vcc3v3_sd";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

&i2s0_8ch {
	status = "okay";
};

&i2s1_8ch {
	rockchip,trcm-sync-tx-only;
	status = "okay";
};

&pinctrl {
	leds {
		work_led_pin: work-led-pin {
			rockchip,pins = <0 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		fan_pin: fan-pin {
			rockchip,pins = <0 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		vcc5v0_usb_host_en: vcc5v0-usb-host-en {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		vcc5v0_usb_otg_en: vcc5v0-usb-otg-en {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pmu_io_domains {
	/* 数值与 lyw-kf 实机 io-domains 逐项一致（且与 T68M 相同映射） */
	pmuio1-supply = <&vcc3v3_pmu>;
	pmuio2-supply = <&vcc3v3_pmu>;
	vccio1-supply = <&vccio_acodec>;
	vccio2-supply = <&vcc_1v8>;
	vccio3-supply = <&vccio_sd>;
	vccio4-supply = <&vcc_1v8>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc_1v8>;
	vccio7-supply = <&vcc_3v3>;
	status = "okay";
};

&saradc {
	vref-supply = <&vcca_1v8>;
	status = "okay";
};

&sata2 {
	/* 数据口，不参与启动（README） */
	status = "okay";
};

&sdhci {
	/* eMMC 64G：厂商实机 8bit/200MHz（与 T68M 同款配置） */
	bus-width = <8>;
	max-frequency = <200000000>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_datastrobe>;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vcc_1v8>;
	status = "okay";
};

&sdmmc0 {
	/* microSD：cd = GPIO0 PA4（厂商实机），vmmc/vqmmc = RK809 SWITCH_REG2/LDO_REG5 */
	bus-width = <4>;
	cap-sd-highspeed;
	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	sd-uhs-sdr50;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

&sdmmc2 {
	/* SDIO WiFi (SWT6621S)：实机 SDR104 + pwrseq（见 sdio_pwrseq 注释） */
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	disable-wp;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc2m0_bus4 &sdmmc2m0_clk &sdmmc2m0_cmd>;
	sd-uhs-sdr104;
	supports-sdio;
	vmmc-supply = <&vcc3v3_sys>;
	vqmmc-supply = <&vcc_1v8>;
	status = "okay";
};

&tsadc {
	rockchip,hw-tshut-mode = <1>;
	rockchip,hw-tshut-polarity = <0>;
	status = "okay";
};

&uart2 {
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usbdrd_dwc3 {
	extcon = <&usb2phy0>;
	status = "okay";
};

&usbhost_dwc3 {
	status = "okay";
};

/* USB3 glue 父节点必须显式使能（T68M 2026-10 实机教训：父节点默认 disabled
   时整棵 dwc3 子树不实例化）。 */
&usbdrd30 {
	status = "okay";
};

&usbhost30 {
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&usb2phy0_host {
	phy-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

&usb2phy0_otg {
	phy-supply = <&vcc5v0_usb_otg>;
	status = "okay";
};

&usb2phy1 {
	status = "okay";
};

&u2phy1_host {
	phy-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

&u2phy1_otg {
	phy-supply = <&vcc5v0_usb_host>;
	status = "okay";
};

&pcie30phy {
	/* 不写 data-lanes（金标准对照定论）：
	   R1 官方 DTB、飞牛线（同板实机 NVMe 正常）的 phy@fe8c0000 均无此属性；
	   仅 T68M（1+1 bifurcation 分叉板）才写 <1 2>。K1 是聚合 x2 NVMe，
	   照抄后实测 rockchip_p3phy_rk3568_init: lock failed 0x6890000
	   （check input refclk and power supply）→ phy init -110 → dw-pcie -22。
	   SNPS 驱动源码不读 data-lanes，其影响经 u-boot 初始化路径注入。 */
	status = "okay";
};

&pcie3x2 {
	/* M.2 NVMe：x2 lanes 聚合（厂商实机 bus-range 0x20-0x2f）。
	   单口 NVMe 不需要 bifurcation（T68M 双 RTL8125 才要）。 */
	num-lanes = <2>;
	reset-gpios = <&gpio2 RK_PD6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie>;
	status = "okay";
};

&vop {
	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

/* NPU 关闭（与成功线 T68M 一致：其 DTS 注释明写"厂商出厂设备树里亦为
   disabled，此处同样保持关闭"）。实机教训：okay 后 15.93s 必 panic——
   rockchip-pm-domain 向 npu 域发 idle 请求等不到 ack
   （failed to get ack on domain 'npu', val=0x1ee），触发 vendor 内核
   panic_on_set_idle 调试开关直接 Kernel panic。软路由/NAS 场景不用 NPU。 */
&rknpu {
	status = "disabled";
	rknpu-supply = <&vdd_npu>;
};

&rknpu_mmu {
	status = "disabled";
};

&bus_npu {
	compatible = "rockchip,rk3568-bus";
	rockchip,busfreq-policy = "clkfreq";
	status = "disabled";
	bus-supply = <&vdd_logic>;
	pvtm-supply = <&vdd_cpu>;
};

/* ══════════════════════════════════════════════════════════════════
 * SoC IP 块使能（照抄官方基线 rk3568-roc-k40pro.dtsi / T68M 同款，
 * 缺失会导致硬编解/RGA/JPEG/硬件随机数/dfi 不可用）
 * ══════════════════════════════════════════════════════════════════ */
&dfi {
	status = "okay";
};

&iep {
	status = "okay";
};

&iep_mmu {
	status = "okay";
};

&jpegd {
	status = "okay";
};

&jpegd_mmu {
	status = "okay";
};

&mpp_srv {
	status = "okay";
};

&rk_rga {
	status = "okay";
};

&rkvdec {
	status = "okay";
};

&rkvdec_mmu {
	status = "okay";
};

&rkvenc {
	venc-supply = <&vdd_logic>;
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};

&rng {
	status = "okay";
};

/* 真 VPU（video-codec@fdea0400，硬解/RGA 侧命门）——
   与同地址占位节点 vdpu@fdea0400 不同，漏了它 CI 后处理校验必挂（实测踩到） */
&vpu {
	status = "okay";
};

&vdpu {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&vepu {
	status = "okay";
};

&vepu_mmu {
	status = "okay";
};
