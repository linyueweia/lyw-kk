			press-threshold-microvolt = <0x6d6>;
		};
	};
	audiopwmout-diff {
		status = "disabled";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "rockchip,audiopwmout-diff";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,bitclock-master = <&{/audiopwmout-diff/simple-audio-card,codec}>;
		simple-audio-card,frame-master = <&{/audiopwmout-diff/simple-audio-card,codec}>;
		simple-audio-card,cpu {
			sound-dai = <&{/i2s@fe430000}>;
		};
		simple-audio-card,codec {
			sound-dai = <&{/codec-digital@fe478000}>;
		};
	};
	dc_12v: dc-12v {
		compatible = "regulator-fixed";
		regulator-name = "dc_12v";
		regulator-always-on;
		regulator-boot-on;

		regulator-min-microvolt = <0xb71b00>;
		regulator-max-microvolt = <0xb71b00>;
	};
	debug@fd904000 {
		compatible = "rockchip,debug";
		reg = <0x0 0xfd904000 0x0 0x1000>,
			<0x0 0xfd905000 0x0 0x1000>,
			<0x0 0xfd906000 0x0 0x1000>,
			<0x0 0xfd907000 0x0 0x1000>;
	};
	cspmu@fd90c000 {
		compatible = "rockchip,cspmu";
		reg = <0x0 0xfd90c000 0x0 0x1000>,
			<0x0 0xfd90d000 0x0 0x1000>,
			<0x0 0xfd90e000 0x0 0x1000>,
			<0x0 0xfd90f000 0x0 0x1000>;
	};

	leds {
		compatible = "gpio-leds";
		work-led {
			gpios = <&{/pinctrl/gpio@fdd60000} 0x1d 0x00>;
			linux,default-trigger = "heartbeat";
		};
		gpio1a4 {
			gpios = <&gpio1 0x04 0x00>;
			default-state = "off";
		};
		gpio1b0 {
			gpios = <&gpio1 0x08 0x00>;
			default-state = "off";
		};
		gpio1b1 {
			gpios = <&gpio1 0x09 0x00>;
			default-state = "off";
		};
		gpio1b2 {
			gpios = <&gpio1 0x0a 0x00>;
			default-state = "off";
		};
		gpio4c4 {
			gpios = <&gpio4 0x14 0x00>;
			default-state = "off";
		};
		gpio3b6 {
			gpios = <&gpio3 0x0e 0x00>;
			default-state = "off";
		};
		gpio1d0 {
			gpios = <&{/pinctrl/gpio@fe740000} 0x18 0x00>;
			default-state = "off";
		};
		gpio1d4 {
			gpios = <&{/pinctrl/gpio@fe740000} 0x1c 0x00>;
			default-state = "off";
		};
		gpio3b5 {
			gpios = <&gpio3 0x0d 0x00>;
			default-state = "off";
		};
		fan {
			gpios = <&gpio0 0x1e 0x00>;
			default-state = "on";
		};
	};
	dummy-codec {
		status = "disabled";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0x00>;
	};
	pdm-mic-array {
		status = "disabled";
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,pdm-mic-array";
		simple-audio-card,cpu {
			sound-dai = <&{/pdm@fe440000}>;
		};
		simple-audio-card,codec {
			sound-dai = <&{/dummy-codec}>;
		};
	};
	rk809-sound {
		status = "okay";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-rk809";
		rockchip,format = "i2s";
		rockchip,mclk-fs = <0x100>;
		rockchip,cpu = <&{/i2s@fe410000}>;
		rockchip,codec = <&{/i2c@fdd40000/pmic@20/codec}>;
		spk-det-gpio = <&{/pinctrl/gpio@fe770000} 0x16 0x01>;
		hp-det-gpio = <&{/pinctrl/gpio@fe740000} 0x1b 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/headphone/hp-det}>;
		hp-volume = <0x14>;
		spk-volume = <0x1e>;
	};
	vad-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip,rk3568-vad";
		rockchip,cpu = <&{/i2s@fe410000}>;
		rockchip,codec = <&{/i2c@fdd40000/pmic@20/codec} &{/vad@fe450000}>;
	};
	vcc3v3_sys: vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <&{/dc-12v}>;
	};
	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <&{/dc-12v}>;
	};
	vcc5v0_usb: vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <&{/dc-12v}>;
	};
	hdmi-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <0x80>;
		simple-audio-card,name = "rockchip,hdmi";
		status = "okay";
		simple-audio-card,cpu {
			sound-dai = <&{/i2s@fe400000}>;
		};
		simple-audio-card,codec {
			sound-dai = <&{/hdmi@fe0a0000}>;
		};
	};
	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&{/i2c@fdd40000/pmic@20} 0x01>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/sdio-pwrseq/wifi-enable-h}>;
		post-power-on-delay-ms = <0xc8>;
	};
	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		wifi_chip_type = "rtl8822cs";
		WIFI,poweren_gpio = <&{/pinctrl/gpio@fe760000} 0x1d 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/wireless-wlan/wifi-host-wake-irq}>;
		WIFI,host_wake_irq = <&{/pinctrl/gpio@fe760000} 0x1c 0x00>;
		status = "okay";
	};
	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <&{/i2c@fdd40000/pmic@20} 0x01>;
		clock-names = "ext_clock";
		uart_rts_gpios = <&{/pinctrl/gpio@fe750000} 0x09 0x01>;
		pinctrl-names = "default\0rts_gpio";
		pinctrl-0 = <&{/pinctrl/uart8/uart8m0-rtsn}>;
	pinctrl-1 = <&{/pinctrl/wireless-bluetooth/uart8-gpios}>;
		BT,power_gpio = <&{/pinctrl/gpio@fe760000} 0x00 0x00>;
		BT,wake_gpio = <&{/pinctrl/gpio@fe760000} 0x01 0x00>;
		BT,wake_host_irq = <&{/pinctrl/gpio@fe760000} 0x02 0x00>;
		status = "okay";
	};
	vcc5v0_host: vcc5v0-host-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <&gpio0 0x06 0x00>;
		vin-supply = <&{/vcc5v0-usb}>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/usb/vcc5v0-host-en}>;
	};
	vcc5v0_otg: vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg";
		enable-active-high;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <&{/pinctrl/gpio@fdd60000} 0x05 0x00>;
		vin-supply = <&{/vcc5v0-usb}>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/usb/vcc5v0-otg-en}>;
	};
	pcie30_avdd0v9: pcie30-avdd0v9 {
		compatible = "regulator-fixed";
		regulator-name = "pcie30_avdd0v9";
		regulator-always-on;
		regulator-boot-on;

		regulator-min-microvolt = <0xdbba0>;
		regulator-max-microvolt = <0xdbba0>;
		vin-supply = <&{/vcc3v3-sys}>;
	};
	pcie30_avdd1v8: pcie30-avdd1v8 {
		compatible = "regulator-fixed";
		regulator-name = "pcie30_avdd1v8";
		regulator-always-on;
		regulator-boot-on;

		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <&{/vcc3v3-sys}>;
	};
	vcc3v3_pcie: gpio-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie";
		enable-active-high;

		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&{/pinctrl/gpio@fdd60000} 0x1c 0x00>;
		startup-delay-us = <0x1388>;
		vin-supply = <&{/dc-12v}>;
	};
	pcie3_power: pcie3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "pcie3_power";
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;

		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&{/pinctrl/gpio@fdd60000} 0x1c 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/pcie3/pcie3-power-en}>;
	};
	minipcie_power: minipcie-regulator {
		compatible = "regulator-fixed";
		regulator-name = "minipcie_power";
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;

		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&gpio3 0x13 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/minipcie/minipcie-power-en}>;
	};
	vcc2v5_sys: vcc2v5-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc2v5-sys";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x2625a0>;
		regulator-max-microvolt = <0x2625a0>;
		vin-supply = <&{/vcc3v3-sys}>;
	};
	vcc3v3_bu: vcc3v3-bu {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_bu";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <&{/vcc5v0-sys}>;
	};
	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0x02>;
		rockchip,wake-irq = <0x00>;
		rockchip,irq-mode-enable = <0x01>;
		rockchip,baudrate = <0x16e360>;
		interrupts = <0x00 0xfc 0x08>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/uart2/uart2m0-xfer}>;
		status = "okay";
	};
};

&pinctrl {
	/* 板级独有 pinctrl 组（6.1 树未定义，随本文件转写） */
	acodec {
		acodec-pins {
			rockchip,pins = <0x01 0x09 0x05 &pcfg_pull_none 0x01 0x01 0x05 &pcfg_pull_none 0x01 0x00 0x05 &pcfg_pull_none 0x01 0x07 0x05 &pcfg_pull_none 0x01 0x08 0x05 &pcfg_pull_none 0x01 0x03 0x05 &pcfg_pull_none 0x01 0x05 0x05 &pcfg_pull_none>;
		};
	};
	cam {
		camera-pwr {
			rockchip,pins = <0x01 0x1b 0x00 &pcfg_pull_none>;
		};
	};
	can0 {
		can0m1-pins {
			rockchip,pins = <0x02 0x02 0x04 &pcfg_pull_none 0x02 0x01 0x04 &pcfg_pull_none>;
		};
	};
	can1 {
		can1m1-pins {
			rockchip,pins = <0x04 0x12 0x03 &pcfg_pull_none 0x04 0x13 0x03 &pcfg_pull_none>;
		};
	};
	can2 {
		can2m1-pins {
			rockchip,pins = <0x02 0x09 0x04 &pcfg_pull_none 0x02 0x0a 0x04 &pcfg_pull_none>;
		};
	};
	cif {
		cif-clk {
			rockchip,pins = <0x04 0x10 0x01 &pcfg_pull_none>;
		};
	};
	clk32k {
		clk32k-out0 {
			rockchip,pins = <0x00 0x08 0x02 &pcfg_pull_none>;
		};
	};
	ebc {
		ebc-pins {
			rockchip,pins = <0x04 0x10 0x02 &pcfg_pull_none 0x04 0x0b 0x02 &pcfg_pull_none 0x04 0x0c 0x02 &pcfg_pull_none 0x04 0x06 0x02 &pcfg_pull_none 0x04 0x11 0x02 &pcfg_pull_none 0x03 0x16 0x02 &pcfg_pull_none 0x03 0x17 0x02 &pcfg_pull_none 0x03 0x18 0x02 &pcfg_pull_none 0x03 0x19 0x02 &pcfg_pull_none 0x03 0x1a 0x02 &pcfg_pull_none 0x03 0x1b 0x02 &pcfg_pull_none 0x03 0x1c 0x02 &pcfg_pull_none 0x03 0x1d 0x02 &pcfg_pull_none 0x03 0x1e 0x02 &pcfg_pull_none 0x03 0x1f 0x02 &pcfg_pull_none 0x04 0x00 0x02 &pcfg_pull_none 0x04 0x01 0x02 &pcfg_pull_none 0x04 0x02 0x02 &pcfg_pull_none 0x04 0x03 0x02 &pcfg_pull_none 0x04 0x04 0x02 &pcfg_pull_none 0x04 0x05 0x02 &pcfg_pull_none 0x04 0x0e 0x02 &pcfg_pull_none 0x04 0x0f 0x02 &pcfg_pull_none>;
		};
	};
	gmac0 {
		gmac0-miim {
			rockchip,pins = <0x02 0x13 0x02 &pcfg_pull_none 0x02 0x14 0x02 &pcfg_pull_none>;
		};
		gmac0-rgmii-bus {
			rockchip,pins = <0x02 0x03 0x02 &pcfg_pull_none 0x02 0x04 0x02 &pcfg_pull_none 0x02 0x06 0x02 &pcfg_pull_none_drv_level_2 0x02 0x07 0x02 &pcfg_pull_none_drv_level_2>;
		};
		gmac0-rgmii-clk {
			rockchip,pins = <0x02 0x05 0x02 &pcfg_pull_none 0x02 0x08 0x02 &pcfg_pull_none_drv_level_1>;
		};
		gmac0-rx-bus2 {
			rockchip,pins = <0x02 0x0e 0x01 &pcfg_pull_none 0x02 0x0f 0x02 &pcfg_pull_none 0x02 0x10 0x02 &pcfg_pull_none>;
		};
		gmac0-tx-bus2 {
			rockchip,pins = <0x02 0x0b 0x01 &pcfg_pull_none_drv_level_2 0x02 0x0c 0x01 &pcfg_pull_none_drv_level_2 0x02 0x0d 0x01 &pcfg_pull_none>;
		};
	};
	gmac1 {
		gmac1m1-miim {
			rockchip,pins = <0x04 0x0e 0x03 &pcfg_pull_none 0x04 0x0f 0x03 &pcfg_pull_none>;
		};
		gmac1m1-rgmii-bus {
			rockchip,pins = <0x04 0x01 0x03 &pcfg_pull_none 0x04 0x02 0x03 &pcfg_pull_none 0x03 0x1e 0x03 &pcfg_pull_none_drv_level_2 0x03 0x1f 0x03 &pcfg_pull_none_drv_level_2>;
		};
		gmac1m1-rgmii-clk {
			rockchip,pins = <0x04 0x03 0x03 &pcfg_pull_none 0x04 0x00 0x03 &pcfg_pull_none_drv_level_1>;
		};
		gmac1m1-rx-bus2 {
			rockchip,pins = <0x04 0x07 0x03 &pcfg_pull_none 0x04 0x08 0x03 &pcfg_pull_none 0x04 0x09 0x03 &pcfg_pull_none>;
		};
		gmac1m1-tx-bus2 {
			rockchip,pins = <0x04 0x04 0x03 &pcfg_pull_none_drv_level_2 0x04 0x05 0x03 &pcfg_pull_none_drv_level_2 0x04 0x06 0x03 &pcfg_pull_none>;
		};
	};
	gpio-func {
		tsadc-gpio-func {
			rockchip,pins = <0x00 0x01 0x00 &pcfg_pull_none>;
		};
	};
	hdmitx {
		hdmitx-scl {
			rockchip,pins = <0x04 0x17 0x01 &pcfg_pull_none>;
		};
		hdmitx-sda {
			rockchip,pins = <0x04 0x18 0x01 &pcfg_pull_none>;
		};
		hdmitxm0-cec {
			rockchip,pins = <0x04 0x19 0x01 &pcfg_pull_none>;
		};
	};
	headphone {
		hp-det {
			rockchip,pins = <0x01 0x1b 0x00 &pcfg_pull_up>;
		};
	};
	i2c0 {
		i2c0-xfer {
			rockchip,pins = <0x00 0x09 0x01 &pcfg_pull_none_smt 0x00 0x0a 0x01 &pcfg_pull_none_smt>;
		};
	};
	i2c1 {
		i2c1-xfer {
			rockchip,pins = <0x00 0x0b 0x01 &pcfg_pull_none_smt 0x00 0x0c 0x01 &pcfg_pull_none_smt>;
		};
	};
	i2c2 {
		i2c2m1-xfer {
			rockchip,pins = <0x04 0x0d 0x01 &pcfg_pull_none_smt 0x04 0x0c 0x01 &pcfg_pull_none_smt>;
		};
	};
	i2c3 {
		i2c3m0-xfer {
			rockchip,pins = <0x01 0x01 0x01 &pcfg_pull_none_smt 0x01 0x00 0x01 &pcfg_pull_none_smt>;
		};
	};
	i2c4 {
		i2c4m0-xfer {
			rockchip,pins = <0x04 0x0b 0x01 &pcfg_pull_none_smt 0x04 0x0a 0x01 &pcfg_pull_none_smt>;
		};
	};
	i2c5 {
		i2c5m0-xfer {
			rockchip,pins = <0x03 0x0b 0x04 &pcfg_pull_none_smt 0x03 0x0c 0x04 &pcfg_pull_none_smt>;
		};
	};
	i2s1 {
		i2s1m0-lrcktx {
			rockchip,pins = <0x01 0x05 0x01 &pcfg_pull_none_smt>;
		};
		i2s1m0-mclk {
			rockchip,pins = <0x01 0x02 0x01 &pcfg_pull_none_smt>;
		};
		i2s1m0-sclktx {
			rockchip,pins = <0x01 0x03 0x01 &pcfg_pull_none_smt>;
		};
		i2s1m0-sdi0 {
			rockchip,pins = <0x01 0x0b 0x01 &pcfg_pull_none>;
		};
		i2s1m0-sdo0 {
			rockchip,pins = <0x01 0x07 0x01 &pcfg_pull_none>;
		};
	};
	i2s2 {
		i2s2m0-lrcktx {
			rockchip,pins = <0x02 0x13 0x01 &pcfg_pull_none_smt>;
		};
		i2s2m0-sclktx {
			rockchip,pins = <0x02 0x12 0x01 &pcfg_pull_none_smt>;
		};
		i2s2m0-sdi {
			rockchip,pins = <0x02 0x15 0x01 &pcfg_pull_none>;
		};
		i2s2m0-sdo {
			rockchip,pins = <0x02 0x14 0x01 &pcfg_pull_none>;
		};
	};
	i2s3 {
		i2s3m0-lrck {
			rockchip,pins = <0x03 0x04 0x04 &pcfg_pull_none_smt>;
		};
		i2s3m0-sclk {
			rockchip,pins = <0x03 0x03 0x04 &pcfg_pull_none_smt>;
		};
		i2s3m0-sdi {
			rockchip,pins = <0x03 0x06 0x04 &pcfg_pull_none>;
		};
		i2s3m0-sdo {
			rockchip,pins = <0x03 0x05 0x04 &pcfg_pull_none>;
		};
	};
	lcdc {
		lcdc-ctl {
