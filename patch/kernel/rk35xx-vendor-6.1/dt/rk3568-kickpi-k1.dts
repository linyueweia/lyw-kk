/* 过温保护（实机 tsadc@fe710000 = okay） */
&tsadc {
	status = "okay";
};

/* 休眠（实机 rockchip-suspend = okay，sleep 配置 dtsi 已带同值，无需重写） */
&rockchip_suspend {
	status = "okay";
};

/* PMU IO 电压域（实机 /syscon@fdc20000/io-domains = okay，supply 按实机原值） */
&pmu_io_domains {
	status = "okay";
	pmuio2-supply = <&vcc3v3_pmu>;  /* 实机 0x2f -> RK809 LDO_REG6 */
	vccio1-supply = <&vccio_acodec>; /* 实机 0x30 -> RK809 LDO_REG4 */
	vccio3-supply = <&vccio_sd>;     /* 实机 0x31 -> RK809 LDO_REG5 */
	vccio4-supply = <&vcc_1v8>;      /* 实机 0x32 -> RK809 DCDC_REG5 */
	vccio5-supply = <&vcc_3v3>;      /* 实机 0x33 -> RK809 SWITCH_REG1 */
	vccio6-supply = <&vcc_1v8>;      /* 实机 0x32 -> RK809 DCDC_REG5 */
	vccio7-supply = <&vcc_3v3>;      /* 实机 0x33 -> RK809 SWITCH_REG1 */
};

/* USB2 PHY 四个端口（实机 host-port / otg-port = okay；dwc3 的 phys 正引用它们，
 * 端口 disabled 时 USB 不起来） */
&u2phy0_host {
	status = "okay";
	phy-supply = <&vcc5v0_host>; /* 实机 0x123 -> /vcc5v0-host-regulator */
};

&u2phy0_otg {
	status = "okay";
	vbus-supply = <&vcc5v0_otg>; /* 实机 0x124 -> /vcc5v0-otg-regulator */
};

&u2phy1_host {
	status = "okay";
	phy-supply = <&vcc5v0_host>; /* 实机 0x123 -> /vcc5v0-host-regulator */
};

&u2phy1_otg {
	status = "okay";
	phy-supply = <&vcc5v0_host>; /* 实机 0x123 -> /vcc5v0-host-regulator */
};
