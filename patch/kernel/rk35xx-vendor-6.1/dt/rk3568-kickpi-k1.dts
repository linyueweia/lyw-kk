		not-save-power-en = <0x01>;
		vcc1-supply = <&{/vcc3v3-sys}>;
		vcc2-supply = <&{/vcc3v3-sys}>;
		vcc3-supply = <&{/vcc3v3-sys}>;
		vcc4-supply = <&{/vcc3v3-sys}>;
		vcc5-supply = <&{/vcc3v3-sys}>;
		vcc6-supply = <&{/vcc3v3-sys}>;
		vcc7-supply = <&{/vcc3v3-sys}>;
		vcc8-supply = <&{/vcc3v3-sys}>;
		vcc9-supply = <&{/vcc3v3-sys}>;
	};
