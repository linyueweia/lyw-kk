			default-state = "off";
		};
		gpio4c4 {
			gpios = <&gpio4 0x14 0x00>;
			default-state = "off";
		};
		gpio3b6 {
			gpios = <&gpio3 0x0e 0x00>;
			default-state = "off";
		};
		gpio1d0 {
			gpios = <&gpio1 &{/vop@fe040000/ports/port@0/endpoint@1} 0x00>;
			default-state = "off";
		};
		gpio1d4 {
			gpios = <&gpio1 &{/vop@fe040000/ports/port@2/endpoint@2} 0x00>;
			default-state = "off";
		};
		gpio3b5 {
			gpios = <&gpio3 0x0d 0x00>;
			default-state = "off";
		};
		fan {
			gpios = <&gpio0 0x1e 0x00>;
			default-state = "on";
		};
	};
	dummy-codec {
		status = "disabled";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0x00>;
	};
	pdm-mic-array {
		status = "disabled";
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,pdm-mic-array";
		simple-audio-card,cpu {
			sound-dai = <0x135>;
		};
		simple-audio-card,codec {
			sound-dai = <0x136>;
		};
	};
	rk809-sound {
		status = "okay";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-rk809";
		rockchip,format = "i2s";
		rockchip,mclk-fs = <0x100>;
		rockchip,cpu = <0xdf>;
		rockchip,codec = <0x137>;
		spk-det-gpio = <&gpio4 &{/dmc} &{/interrupt-controller@fd400000}>;
		hp-det-gpio = <&gpio1 &{/vop@fe040000/ports/port@1/endpoint@4} 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/headphone/hp-det}>;
		hp-volume = <0x14>;
		spk-volume = <0x1e>;
	};
	vad-sound {
		status = "disabled";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip,rk3568-vad";
		rockchip,cpu = <0xdf>;
		rockchip,codec = <0x137 0x139>;
	};
	vcc3v3_sys: vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x13a>;
	};
	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x13a>;
	};
	vcc5v0_usb: vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x13a>;
	};
	hdmi-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <0x80>;
		simple-audio-card,name = "rockchip,hdmi";
		status = "okay";
		simple-audio-card,cpu {
			sound-dai = <0x13b>;
		};
		simple-audio-card,codec {
			sound-dai = <0x13c>;
		};
	};
	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&{/i2c@fdd40000/pmic@20} &{/interrupt-controller@fd400000}>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/sdio-pwrseq/wifi-enable-h}>;
		post-power-on-delay-ms = <0xc8>;
	};
	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		wifi_chip_type = "rtl8822cs";
		WIFI,poweren_gpio = <0x8b 0x1d 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/wireless-wlan/wifi-host-wake-irq}>;
		WIFI,host_wake_irq = <0x8b 0x1c 0x00>;
		status = "okay";
	};
	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <&{/i2c@fdd40000/pmic@20} &{/interrupt-controller@fd400000}>;
		clock-names = "ext_clock";
		uart_rts_gpios = <0xbb 0x09 0x01>;
		pinctrl-names = "default\0rts_gpio";
		pinctrl-0 = <&{/pinctrl/uart8/uart8m0-rtsn}>;
		BT,power_gpio = <0x8b 0x00 0x00>;
		BT,wake_gpio = <0x8b 0x01 0x00>;
		BT,wake_host_irq = <0x8b 0x02 0x00>;
		status = "okay";
	};
	vcc5v0_host: vcc5v0-host-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <&gpio0 0x06 0x00>;
		vin-supply = <0x142>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/usb/vcc5v0-host-en}>;
	};
	vcc5v0_otg: vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <&gpio0 &vdd_cpu 0x00>;
		vin-supply = <0x142>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/usb/vcc5v0-otg-en}>;
	};
	pcie30_avdd0v9: pcie30-avdd0v9 {
		compatible = "regulator-fixed";
		regulator-name = "pcie30_avdd0v9";
		regulator-min-microvolt = <0xdbba0>;
		regulator-max-microvolt = <0xdbba0>;
		vin-supply = <0x45>;
	};
	pcie30_avdd1v8: pcie30-avdd1v8 {
		compatible = "regulator-fixed";
		regulator-name = "pcie30_avdd1v8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <0x45>;
	};
	vcc3v3_pcie: gpio-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&gpio0 &{/vop@fe040000/ports/port@2/endpoint@2} 0x00>;
		startup-delay-us = <0x1388>;
		vin-supply = <0x13a>;
	};
	pcie3_power: pcie3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "pcie3_power";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&gpio0 &{/vop@fe040000/ports/port@2/endpoint@2} 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/pcie3/pcie3-power-en}>;
	};
	minipcie_power: minipcie-regulator {
		compatible = "regulator-fixed";
		regulator-name = "minipcie_power";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <&gpio3 0x13 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/minipcie/minipcie-power-en}>;
	};
	vcc2v5_sys: vcc2v5-ddr {
		compatible = "regulator-fixed";
		regulator-name = "vcc2v5-sys";
		regulator-min-microvolt = <0x2625a0>;
		regulator-max-microvolt = <0x2625a0>;
		vin-supply = <0x45>;
	};
	vcc3v3_bu: vcc3v3-bu {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_bu";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x3d>;
	};
	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0x02>;
		rockchip,wake-irq = <0x00>;
		rockchip,irq-mode-enable = <0x01>;
		rockchip,baudrate = <0x16e360>;
		interrupts = <0x00 0xfc 0x08>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/uart2/uart2m0-xfer}>;
		status = "okay";
	};
};

