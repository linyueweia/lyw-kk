		io-channels = <&saradc 0x00>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <0x1b7740>;
		poll-interval = <0x64>;
		vol-up-key {
			label = "volume up";
			linux,code = <0x73>;
			press-threshold-microvolt = <0x6d6>;
		};
	};
	audiopwmout-diff {
		status = "disabled";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "rockchip,audiopwmout-diff";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,bitclock-master = <0x132>;
		simple-audio-card,frame-master = <0x132>;
		simple-audio-card,cpu {
			sound-dai = <0x133>;
		};
		simple-audio-card,codec {
			sound-dai = <0x134>;
		};
	};
	dc_12v: dc-12v {
		compatible = "regulator-fixed";
		regulator-name = "dc_12v";
		regulator-min-microvolt = <0xb71b00>;
		regulator-max-microvolt = <0xb71b00>;
	};
	leds {
		compatible = "gpio-leds";
		work-led {
			gpios = <&gpio0 &{/vop@fe040000/ports/port@2/endpoint@1} 0x00>;
			linux,default-trigger = "heartbeat";
		};
		gpio1a4 {
			gpios = <&gpio1 0x04 0x00>;
			default-state = "off";
		};
		gpio1b0 {
			gpios = <&gpio1 0x08 0x00>;
			default-state = "off";
		};
		gpio1b1 {
			gpios = <&gpio1 0x09 0x00>;
			default-state = "off";
		};
		gpio1b2 {
