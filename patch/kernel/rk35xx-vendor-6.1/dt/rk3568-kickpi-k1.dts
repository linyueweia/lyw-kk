&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/i2c4/i2c4m0-xfer}>;
	status = "okay";
	gc5035@37 {
		compatible = "galaxycore,gc5035";
		status = "okay";
		reg = <0x37>;
		clocks = <&{/clock-controller@fdd20000} 0xd6>;
		clock-names = "xvclk";
		power-domains = <&{/power-management@fdd90000/power-controller} 0x08>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/cif/cif-clk}>;
		reset-gpios = <&gpio0 0x0f 0x00>;
		pwdn-gpios = <&{/pinctrl/gpio@fe740000} 0x19 0x00>;
		rockchip,camera-module-index = <0x00>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "default";
		rockchip,camera-module-lens-name = "PC5322-M5";
		port {
			endpoint {
				remote-endpoint = <&{/csi2-dphy0/ports/port@0/endpoint@1}>;
				data-lanes = <0x01 0x02>;
			};
		};
	};
};

/* 实机 /csi2-dphy0 = okay 且带 ports/endpoint（GC5035 的 graph 对端就在这个 endpoint@1）；
 * 6.1 dtsi 默认 disabled 且没有 ports 子节点 → 按实机补齐，否则 remote-endpoint 悬空。 */
&csi2_dphy0 {
	status = "okay";
	ports {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		port@0 {
			reg = <0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&{/i2c@fe5d0000/gc5035@37/port/endpoint}>;
				data-lanes = <0x01 0x02>;
			};
		};

		/* 第二段：dphy0 -> ISP（LIVE 2566；SDK rk3568-kickpi-mipi-camera-gc5035.dtsi:23-32） */
		port@1 {
			reg = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			csidphy_out: endpoint@0 {
				reg = <0x00>;
				remote-endpoint = <&isp0_in>;
			};
		};
	};
};

