&gmac1 {
	rockchip,grf = <&grf>;
	status = "okay";
	phy-mode = "rgmii";
	clock_in_out = "output";
	snps,reset-gpio = <&gpio3 RK_PA7 GPIO_ACTIVE_LOW>;
	snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
	snps,reset-active-low;
	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>, <&cru CLK_MAC1_2TOP>;
	assigned-clock-rates = <0>, <125000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/gmac1/gmac1m1-miim} &{/pinctrl/gmac1/gmac1m1-tx-bus2} &{/pinctrl/gmac1/gmac1m1-rx-bus2} &{/pinctrl/gmac1/gmac1m1-rgmii-clk} &{/pinctrl/gmac1/gmac1m1-rgmii-bus}>;
	tx_delay = <0x2f>;
	rx_delay = <0x39>;
	phy-handle = <&{/ethernet@fe010000/mdio/phy@0}>;
	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0x00>;
		};
	};
	rx-queues-config {
		snps,rx-queues-to-use = <0x01>;
	};
	tx-queues-config {
		snps,tx-queues-to-use = <0x01>;
	};
};

&vop {
	rockchip,grf = <&grf>;
	status = "okay";
	assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>, <&cru DCLK_VOP2>;
	assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>, <&cru PLL_GPLL>;
	disable-win-move;
	ports {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		port@0 {
			rockchip,primary-plane = <0x04>;
			rockchip,plane-mask = <0x15>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00>;
			endpoint@0 {
				reg = <0x00>;
				remote-endpoint = <&{/dsi@fe060000/ports/port@0/endpoint@0}>;
			};
			endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&{/dsi@fe070000/ports/port@0/endpoint@0}>;
			};
			endpoint@2 {
				reg = <0x02>;
				remote-endpoint = <&{/edp@fe0c0000/ports/port@0/endpoint@0}>;
			};
			endpoint@3 {
				reg = <0x03>;
				remote-endpoint = <&{/hdmi@fe0a0000/ports/port@0/endpoint@0}>;
			};
		};
		port@1 {
			rockchip,primary-plane = <0x05>;
			rockchip,plane-mask = <0x22>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x01>;
			endpoint@0 {
				reg = <0x00>;
				remote-endpoint = <&{/dsi@fe060000/ports/port@0/endpoint@1}>;
			};
			endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&{/dsi@fe070000/ports/port@0/endpoint@1}>;
			};
			endpoint@2 {
				reg = <0x02>;
				remote-endpoint = <&{/edp@fe0c0000/ports/port@0/endpoint@1}>;
			};
			endpoint@3 {
				reg = <0x03>;
				remote-endpoint = <&{/hdmi@fe0a0000/ports/port@0/endpoint@1}>;
			};
			endpoint@4 {
				reg = <0x04>;
				remote-endpoint = <&{/syscon@fdc60000/lvds/ports/port@0/endpoint@1}>;
			};
			endpoint@5 {
				reg = <0x05>;
				remote-endpoint = <&{/syscon@fdc60000/lvds1/ports/port@0/endpoint@0}>;
			};
		};
		port@2 {
			rockchip,primary-plane = <0x03>;
			rockchip,plane-mask = <0x08>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x02>;
			endpoint@0 {
				reg = <0x00>;
				remote-endpoint = <&{/syscon@fdc60000/lvds/ports/port@0/endpoint@2}>;
			};
			endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&{/syscon@fdc60000/rgb/ports/port@0/endpoint@2}>;
			};
			endpoint@2 {
				reg = <0x02>;
				remote-endpoint = <&{/syscon@fdc60000/lvds1/ports/port@0/endpoint@1}>;
			};
		};
	};
};

