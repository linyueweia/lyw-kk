/* ===== SoC 节点覆写（只保留板级相关属性） ===== */
&sata0 {
	status = "okay";
};

&sata1 {
	status = "disabled";
};

&sata2 {
	status = "disabled";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&cru {
	rockchip,grf = <&grf>;
	#clock-cells = <0x01>;
};

&pmucru {
	rockchip,grf = <&grf>;
	#clock-cells = <0x01>;
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/i2c0/i2c0-xfer}>;
	status = "okay";
	vdd_cpu: tcs4525@1c {
		compatible = "tcs,tcs4525";
		reg = <0x1c>;
		vin-supply = <&{/vcc5v0-sys}>;
		regulator-compatible = "fan53555-reg";
		regulator-name = "vdd_cpu";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0xadf34>;
		regulator-max-microvolt = <0x1535b0>;
		regulator-init-microvolt = <0xdbba0>;
		regulator-ramp-delay = <0x8fc>;
		fcs,suspend-voltage-selector = <0x01>;
	
regulator-state-mem {
	regulator-off-in-suspend;
};};
	pmic@20 {
		compatible = "rockchip,rk809";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <0x03 0x08>;
		pinctrl-names = "default\0pmic-sleep\0pmic-power-off\0pmic-reset";
		pinctrl-0 = <&{/pinctrl/pmic/pmic_int}>;
		pinctrl-1 = <&{/pinctrl/pmic/soc_slppin_slp} &{/i2c@fdd40000/pmic@20/pinctrl_rk8xx/rk817_slppin_slp}>;
		pinctrl-2 = <&{/pinctrl/pmic/soc_slppin_gpio} &{/i2c@fdd40000/pmic@20/pinctrl_rk8xx/rk817_slppin_pwrdn}>;
		pinctrl-3 = <&{/pinctrl/pmic/soc_slppin_gpio} &{/i2c@fdd40000/pmic@20/pinctrl_rk8xx/rk817_slppin_rst}>;
		rockchip,system-power-controller;
		wakeup-source;
		#clock-cells = <0x01>;
		clock-output-names = "rk808-clkout1\0rk808-clkout2";
		pmic-reset-func = <0x00>;
		not-save-power-en = <0x01>;
		vcc1-supply = <&{/vcc3v3-sys}>;
		vcc2-supply = <&{/vcc3v3-sys}>;
		vcc3-supply = <&{/vcc3v3-sys}>;
		vcc4-supply = <&{/vcc3v3-sys}>;
		vcc5-supply = <&{/vcc3v3-sys}>;
		vcc6-supply = <&{/vcc3v3-sys}>;
		vcc7-supply = <&{/vcc3v3-sys}>;
		vcc8-supply = <&{/vcc3v3-sys}>;
		vcc9-supply = <&{/vcc3v3-sys}>;
		pwrkey {
			status = "okay";
		};
		pinctrl_rk8xx {
			gpio-controller;
			#gpio-cells = <0x02>;
			rk817_slppin_null {
				pins = "gpio_slp";
				function = "pin_fun0";
			};
			rk817_slppin_slp {
				pins = "gpio_slp";
				function = "pin_fun1";
			};
			rk817_slppin_pwrdn {
				pins = "gpio_slp";
				function = "pin_fun2";
			};
			rk817_slppin_rst {
				pins = "gpio_slp";
				function = "pin_fun3";
			};
		};
		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-min-microvolt = <0x7a120>;
				regulator-max-microvolt = <0x149970>;
				regulator-init-microvolt = <0xdbba0>;
				regulator-ramp-delay = <0x1771>;
				regulator-initial-mode = <0x02>;
				regulator-name = "vdd_logic";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vdd_gpu: DCDC_REG2 {
				regulator-min-microvolt = <0x7a120>;
				regulator-max-microvolt = <0x149970>;
				regulator-init-microvolt = <0xdbba0>;
				regulator-ramp-delay = <0x1771>;
				regulator-initial-mode = <0x02>;
				regulator-name = "vdd_gpu";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vcc_ddr: DCDC_REG3 {
				regulator-initial-mode = <0x02>;
				regulator-name = "vcc_ddr";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-on-in-suspend;
};};
			vdd_npu: DCDC_REG4 {
				regulator-min-microvolt = <0x7a120>;
				regulator-max-microvolt = <0x149970>;
				regulator-init-microvolt = <0xdbba0>;
				regulator-ramp-delay = <0x1771>;
				regulator-initial-mode = <0x02>;
				regulator-name = "vdd_npu";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vdda0v9_image: LDO_REG1 {
				regulator-min-microvolt = <0xdbba0>;
				regulator-max-microvolt = <0xdbba0>;
				regulator-name = "vdda0v9_image";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vdda_0v9: LDO_REG2 {
				regulator-min-microvolt = <0xdbba0>;
				regulator-max-microvolt = <0xdbba0>;
				regulator-name = "vdda_0v9";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vdda0v9_pmu: LDO_REG3 {
				regulator-min-microvolt = <0xdbba0>;
				regulator-max-microvolt = <0xdbba0>;
				regulator-name = "vdda0v9_pmu";
				regulator-boot-on;
				regulator-always-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <0xdbba0>;
					regulator-on-in-suspend;
				};
			};
			vccio_acodec: LDO_REG4 {
				regulator-min-microvolt = <0x2dc6c0>;
				regulator-max-microvolt = <0x2dc6c0>;
				regulator-name = "vccio_acodec";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vccio_sd: LDO_REG5 {
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-name = "vccio_sd";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vcc3v3_pmu: LDO_REG6 {
				regulator-min-microvolt = <0x325aa0>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-name = "vcc3v3_pmu";
				regulator-boot-on;
				regulator-always-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <0x325aa0>;
					regulator-on-in-suspend;
				};
			};
			vcca_1v8: LDO_REG7 {
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-name = "vcca_1v8";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vcca1v8_pmu: LDO_REG8 {
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-name = "vcca1v8_pmu";
				regulator-boot-on;
				regulator-always-on;
				regulator-state-mem {
					regulator-suspend-microvolt = <0x1b7740>;
					regulator-on-in-suspend;
				};
			};
			vcca1v8_image: LDO_REG9 {
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-name = "vcca1v8_image";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vcc_1v8: DCDC_REG5 {
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-name = "vcc_1v8";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vcc_3v3: SWITCH_REG1 {
				regulator-name = "vcc_3v3";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
			vcc3v3_sd: SWITCH_REG2 {
				regulator-name = "vcc3v3_sd";
				regulator-boot-on;
				regulator-always-on;
			
regulator-state-mem {
	regulator-off-in-suspend;
};};
		};
		codec {
			#sound-dai-cells = <0x01>;
			compatible = "rockchip,rk809-codec\0rockchip,rk817-codec";
			clocks = <&{/clock-controller@fdd20000} 0x1a3>;
			clock-names = "mclk";
			spk-ctl-gpios = <&{/pinctrl/gpio@fe770000} 0x16 0x00>;
			assigned-clocks = <&{/clock-controller@fdd20000} 0x1a3 &{/clock-controller@fdd20000} 0x1a6>;
			assigned-clock-rates = <0xbb8000>;
			assigned-clock-parents = <&{/clock-controller@fdd20000} 0x48 &{/clock-controller@fdd20000} 0x48>;
			pinctrl-names = "default";
			pinctrl-0 = <&{/pinctrl/i2s1/i2s1m0-mclk}>;
			hp-volume = <0x00>;
			spk-volume = <0x00>;
			mic-in-differential;
			status = "okay";
		};
	};
};

