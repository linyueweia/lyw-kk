		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "xin24m";
	};
	xin32k {
		compatible = "fixed-clock";
		clock-frequency = <0x8000>;
		clock-output-names = "xin32k";
		#clock-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/clk32k/clk32k-out0}>;
	};
	pinctrl {
		compatible = "rockchip,rk3568-pinctrl";
		rockchip,grf = <&grf>;
		rockchip,pmu = <&pmugrf>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		gpio0@fdd60000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x00 0xfdd60000 0x00 0x100>;
			interrupts = <0x00 0x21 0x04>;
			clocks = <&cru &{/usb2-phy@fe8b0000/host-port} &cru &{/cpus/cpu@0}>;
			#gpio-cells = <0x02>;
			#interrupt-cells = <0x02>;
		};
		gpio1@fe740000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x00 0xfe740000 0x00 0x100>;
			interrupts = <0x00 0x22 0x04>;
			clocks = <&pmucru 0x163 &pmucru 0x164>;
			#gpio-cells = <0x02>;
			#interrupt-cells = <0x02>;
		};
		gpio2@fe750000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x00 0xfe750000 0x00 0x100>;
			interrupts = <0x00 0x23 0x04>;
			clocks = <&pmucru 0x165 &pmucru 0x166>;
			#gpio-cells = <0x02>;
			#interrupt-cells = <0x02>;
		};
		gpio3@fe760000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x00 0xfe760000 0x00 0x100>;
			interrupts = <0x00 0x24 0x04>;
			clocks = <&pmucru 0x167 &pmucru 0x168>;
			#gpio-cells = <0x02>;
			#interrupt-cells = <0x02>;
		};
		gpio4@fe770000 {
			compatible = "rockchip,gpio-bank";
			reg = <0x00 0xfe770000 0x00 0x100>;
			interrupts = <0x00 0x25 0x04>;
			clocks = <&pmucru 0x169 &pmucru 0x16a>;
			#gpio-cells = <0x02>;
			#interrupt-cells = <0x02>;
		};
		pcfg-pull-none-drv-level-1 {
