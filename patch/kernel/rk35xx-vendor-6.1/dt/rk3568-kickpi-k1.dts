		};
		sdmmc2m0-clk {
			rockchip,pins = <0x03 0x1b 0x03 0x128>;
		};
		sdmmc2m0-cmd {
			rockchip,pins = <0x03 0x1a 0x03 0x128>;
		};
	};
	spdif {
		spdifm0-tx {
			rockchip,pins = <0x01 0x04 0x04 0x127>;
		};
	};
	spi0-hs {
		spi0m0-pins {
			rockchip,pins = <0x00 0x0d 0x02 0x12e 0x00 0x15 0x02 0x12e 0x00 0x0e 0x02 0x12e>;
		};
	};
	spi0 {
		spi0m0-cs0 {
			rockchip,pins = <0x00 0x16 0x02 0x127>;
		};
		spi0m0-cs1 {
			rockchip,pins = <0x00 0x14 0x02 0x127>;
		};
		spi0m0-pins {
			rockchip,pins = <0x00 0x0d 0x02 0x127 0x00 0x15 0x02 0x127 0x00 0x0e 0x02 0x127>;
		};
	};
	spi1-hs {
		spi1m0-pins {
			rockchip,pins = <0x02 0x0d 0x03 0x12e 0x02 0x0e 0x03 0x12e 0x02 0x0f 0x04 0x12e>;
		};
	};
	spi1 {
		spi1m0-cs0 {
			rockchip,pins = <0x02 0x10 0x04 0x127>;
		};
		spi1m0-cs1 {
			rockchip,pins = <0x02 0x16 0x03 0x127>;
		};
		spi1m0-pins {
			rockchip,pins = <0x02 0x0d 0x03 0x127 0x02 0x0e 0x03 0x127 0x02 0x0f 0x04 0x127>;
		};
	};
	spi2-hs {
		spi2m0-pins {
			rockchip,pins = <0x02 0x11 0x04 0x12e 0x02 0x12 0x04 0x12e 0x02 0x13 0x04 0x12e>;
		};
	};
	spi2 {
		spi2m0-cs0 {
			rockchip,pins = <0x02 0x14 0x04 0x127>;
		};
		spi2m0-cs1 {
			rockchip,pins = <0x02 0x15 0x04 0x127>;
		};
		spi2m0-pins {
			rockchip,pins = <0x02 0x11 0x04 0x127 0x02 0x12 0x04 0x127 0x02 0x13 0x04 0x127>;
		};
	};
	spi3-hs {
		spi3m1-pins {
			rockchip,pins = <0x04 0x12 0x02 0x12e 0x04 0x15 0x02 0x12e 0x04 0x13 0x02 0x12e>;
		};
	};
	spi3 {
		spi3m1-pins {
			rockchip,pins = <0x04 0x12 0x02 0x127 0x04 0x15 0x02 0x127 0x04 0x13 0x02 0x127>;
		};
	};
	tsadc {
		tsadc-shutorg {
			rockchip,pins = <0x00 0x01 0x02 0x127>;
		};
	};
	uart0 {
		uart0-xfer {
			rockchip,pins = <0x00 0x10 0x03 0x129 0x00 0x11 0x03 0x129>;
		};
	};
	uart1 {
		uart1m0-xfer {
			rockchip,pins = <0x02 0x0b 0x02 0x129 0x02 0x0c 0x02 0x129>;
		};
	};
	uart2 {
		uart2m0-xfer {
			rockchip,pins = <0x00 0x18 0x01 0x129 0x00 0x19 0x01 0x129>;
		};
	};
	uart3 {
		uart3m1-xfer {
			rockchip,pins = <0x03 0x10 0x04 0x129 0x03 0x0f 0x04 0x129>;
		};
	};
	uart4 {
		uart4m1-xfer {
			rockchip,pins = <0x03 0x09 0x04 0x129 0x03 0x0a 0x04 0x129>;
		};
	};
	uart5 {
		uart5m0-xfer {
			rockchip,pins = <0x02 0x01 0x03 0x129 0x02 0x02 0x03 0x129>;
		};
	};
	uart6 {
		uart6m0-xfer {
			rockchip,pins = <0x02 0x03 0x03 0x129 0x02 0x04 0x03 0x129>;
		};
	};
	uart7 {
		uart7m1-xfer {
			rockchip,pins = <0x03 0x15 0x04 0x129 0x03 0x14 0x04 0x129>;
		};
	};
	uart8 {
		uart8m0-ctsn {
			rockchip,pins = <0x02 0x0a 0x03 0x127>;
		};
		uart8m0-rtsn {
			rockchip,pins = <0x02 0x09 0x03 0x127>;
		};
		uart8m0-xfer {
			rockchip,pins = <0x02 0x16 0x02 0x129 0x02 0x15 0x03 0x129>;
		};
	};
	uart9 {
		uart9m0-xfer {
			rockchip,pins = <0x02 0x07 0x03 0x129 0x02 0x08 0x03 0x129>;
		};
	};
	usb {
		vcc5v0-host-en {
			rockchip,pins = <0x00 0x06 0x00 0x127>;
		};
		vcc5v0-otg-en {
			rockchip,pins = <0x00 0x05 0x00 0x127>;
		};
	};
	wireless-bluetooth {
		uart8-gpios {
			rockchip,pins = <0x02 0x09 0x00 0x127>;
		};
	};
	wireless-wlan {
		wifi-host-wake-irq {
			rockchip,pins = <0x03 0x1c 0x00 0x130>;
		};
	};
};

/* ===== SoC 节点覆写（只保留板级相关属性） ===== */
&sata0 {
	status = "okay";
};

&sata1 {
	status = "disabled";
};

&sata2 {
	status = "disabled";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&cru {
	rockchip,grf = <&grf>;
	#clock-cells = <0x01>;
};

&pmucru {
	rockchip,grf = <&grf>;
	#clock-cells = <0x01>;
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/i2c0/i2c0-xfer}>;
	status = "okay";
	vdd_cpu: tcs4525@1c {
		compatible = "tcs,tcs4525";
		reg = <0x1c>;
		vin-supply = <0x3d>;
		regulator-compatible = "fan53555-reg";
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <0xadf34>;
		regulator-max-microvolt = <0x1535b0>;
		regulator-init-microvolt = <0xdbba0>;
		regulator-ramp-delay = <0x8fc>;
		fcs,suspend-voltage-selector = <0x01>;
	};
	pmic@20 {
		compatible = "rockchip,rk809";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <0x03 0x08>;
		pinctrl-names = "default\0pmic-sleep\0pmic-power-off\0pmic-reset";
		pinctrl-0 = <&{/pinctrl/pmic/pmic_int}>;
		#clock-cells = <0x01>;
		clock-output-names = "rk808-clkout1\0rk808-clkout2";
		pmic-reset-func = <0x00>;
		not-save-power-en = <0x01>;
		vcc1-supply = <0x45>;
		vcc2-supply = <0x45>;
		vcc3-supply = <0x45>;
		vcc4-supply = <0x45>;
		vcc5-supply = <0x45>;
		vcc6-supply = <0x45>;
		vcc7-supply = <0x45>;
		vcc8-supply = <0x45>;
		vcc9-supply = <0x45>;
		pwrkey {
			status = "okay";
		};
		pinctrl_rk8xx {
			#gpio-cells = <0x02>;
			rk817_slppin_null {
				pins = "gpio_slp";
				function = "pin_fun0";
			};
			rk817_slppin_slp {
				pins = "gpio_slp";
				function = "pin_fun1";
			};
			rk817_slppin_pwrdn {
				pins = "gpio_slp";
				function = "pin_fun2";
			};
			rk817_slppin_rst {
				pins = "gpio_slp";
				function = "pin_fun3";
			};
		};
		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-min-microvolt = <0x7a120>;
				regulator-max-microvolt = <0x149970>;
				regulator-init-microvolt = <0xdbba0>;
				regulator-ramp-delay = <0x1771>;
				regulator-initial-mode = <0x02>;
				regulator-name = "vdd_logic";
			};
			vdd_gpu: DCDC_REG2 {
				regulator-min-microvolt = <0x7a120>;
				regulator-max-microvolt = <0x149970>;
				regulator-init-microvolt = <0xdbba0>;
				regulator-ramp-delay = <0x1771>;
				regulator-initial-mode = <0x02>;
				regulator-name = "vdd_gpu";
			};
			vcc_ddr: DCDC_REG3 {
				regulator-initial-mode = <0x02>;
				regulator-name = "vcc_ddr";
			};
			vdd_npu: DCDC_REG4 {
				regulator-min-microvolt = <0x7a120>;
				regulator-max-microvolt = <0x149970>;
				regulator-init-microvolt = <0xdbba0>;
				regulator-ramp-delay = <0x1771>;
				regulator-initial-mode = <0x02>;
				regulator-name = "vdd_npu";
			};
			vdda0v9_image: LDO_REG1 {
				regulator-min-microvolt = <0xdbba0>;
				regulator-max-microvolt = <0xdbba0>;
				regulator-name = "vdda0v9_image";
			};
			vdda_0v9: LDO_REG2 {
				regulator-min-microvolt = <0xdbba0>;
				regulator-max-microvolt = <0xdbba0>;
				regulator-name = "vdda_0v9";
			};
			vdda0v9_pmu: LDO_REG3 {
				regulator-min-microvolt = <0xdbba0>;
				regulator-max-microvolt = <0xdbba0>;
				regulator-name = "vdda0v9_pmu";
				regulator-state-mem {
					regulator-suspend-microvolt = <0xdbba0>;
				};
			};
			vccio_acodec: LDO_REG4 {
				regulator-min-microvolt = <0x2dc6c0>;
				regulator-max-microvolt = <0x2dc6c0>;
				regulator-name = "vccio_acodec";
			};
			vccio_sd: LDO_REG5 {
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-name = "vccio_sd";
			};
			vcc3v3_pmu: LDO_REG6 {
				regulator-min-microvolt = <0x325aa0>;
				regulator-max-microvolt = <0x325aa0>;
				regulator-name = "vcc3v3_pmu";
				regulator-state-mem {
					regulator-suspend-microvolt = <0x325aa0>;
				};
			};
			vcca_1v8: LDO_REG7 {
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-name = "vcca_1v8";
			};
			vcca1v8_pmu: LDO_REG8 {
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-name = "vcca1v8_pmu";
				regulator-state-mem {
					regulator-suspend-microvolt = <0x1b7740>;
				};
			};
			vcca1v8_image: LDO_REG9 {
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-name = "vcca1v8_image";
			};
			vcc_1v8: DCDC_REG5 {
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-name = "vcc_1v8";
			};
			vcc_3v3: SWITCH_REG1 {
				regulator-name = "vcc_3v3";
			};
			vcc3v3_sd: SWITCH_REG2 {
				regulator-name = "vcc3v3_sd";
			};
		};
		codec {
			#sound-dai-cells = <0x01>;
			compatible = "rockchip,rk809-codec\0rockchip,rk817-codec";
			clocks = <&pmucru 0x1a3>;
			clock-names = "mclk";
			spk-ctl-gpios = <&gpio4 &{/dmc} 0x00>;
			assigned-clocks = <&pmucru 0x1a3 &pmucru 0x1a6>;
			assigned-clock-rates = <0xbb8000>;
			assigned-clock-parents = <&pmucru &dmac0 &pmucru &dmac0>;
			pinctrl-names = "default";
			pinctrl-0 = <&{/pinctrl/i2s1/i2s1m0-mclk}>;
			hp-volume = <0x00>;
			spk-volume = <0x00>;
			status = "okay";
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/uart0/uart0-xfer}>;
	status = "okay";
};

&pwm0 {
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/pwm0/pwm0m0-pins}>;
	status = "disabled";
};

&pwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/pwm1/pwm1m0-pins}>;
	status = "disabled";
};

&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/pwm2/pwm2m0-pins}>;
	status = "disabled";
};

&pwm3 {
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/pwm3/pwm3-pins}>;
	status = "okay";
};

&rknpu {
	status = "okay";
	rknpu-supply = <&vdd_npu>;
};

&rknpu_mmu {
	status = "okay";
};

&vpu {
	status = "okay";
};

&vdpu_mmu {
	status = "okay";
};

&rk_rga {
	status = "okay";
};

&jpegd {
	status = "okay";
};

&jpegd_mmu {
	status = "okay";
};

&vepu {
	status = "okay";
};

&vepu_mmu {
	status = "okay";
};

&iep {
	status = "okay";
};

&iep_mmu {
	status = "okay";
};

&rkvenc {
	status = "okay";
	venc-supply = <&vdd_logic>;
};

&rkvenc_mmu {
	status = "okay";
};

&rkvdec {
	vdec-supply = <&vdd_logic>;
	status = "okay";
};

&rkvdec_mmu {
	status = "okay";
};

&gmac1 {
	rockchip,grf = <&grf>;
	status = "okay";
	phy-mode = "rgmii";
	clock_in_out = "output";
	snps,reset-gpio = <&gpio3 0x07 &{/interrupt-controller@fd400000}>;
	snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/gmac1/gmac1m1-miim} &{/pinctrl/gmac1/gmac1m1-tx-bus2} &{/pinctrl/gmac1/gmac1m1-rx-bus2} &{/pinctrl/gmac1/gmac1m1-rgmii-clk} &{/pinctrl/gmac1/gmac1m1-rgmii-bus}>;
	tx_delay = <0x2f>;
	rx_delay = <0x39>;
	phy-handle = <&{/ethernet@fe010000/mdio/phy@0}>;
	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0x00>;
		};
	};
	rx-queues-config {
		snps,rx-queues-to-use = <0x01>;
	};
	tx-queues-config {
		snps,tx-queues-to-use = <0x01>;
	};
};

&vop {
	rockchip,grf = <&grf>;
	status = "okay";
	ports {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		port@0 {
			rockchip,primary-plane = <0x04>;
			rockchip,plane-mask = <0x15>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00>;
			endpoint@0 {
				reg = <0x00>;
				remote-endpoint = <&{/dsi@fe060000/ports/port@0/endpoint@0}>;
			};
			endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&{/dsi@fe070000/ports/port@0/endpoint@0}>;
			};
			endpoint@2 {
				reg = <0x02>;
				remote-endpoint = <0x95>;
			};
			endpoint@3 {
				reg = <0x03>;
				remote-endpoint = <&{/hdmi@fe0a0000/ports/port@0/endpoint@0}>;
			};
		};
		port@1 {
			rockchip,primary-plane = <0x05>;
			rockchip,plane-mask = <0x22>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x01>;
			endpoint@0 {
				reg = <0x00>;
				remote-endpoint = <&{/dsi@fe060000/ports/port@0/endpoint@1}>;
			};
			endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&{/dsi@fe070000/ports/port@0/endpoint@1}>;
			};
			endpoint@2 {
				reg = <0x02>;
				remote-endpoint = <0x99>;
			};
			endpoint@3 {
				reg = <0x03>;
				remote-endpoint = <&{/hdmi@fe0a0000/ports/port@0/endpoint@1}>;
			};
			endpoint@4 {
				reg = <0x04>;
				remote-endpoint = <&{/syscon@fdc60000/lvds/ports/port@0/endpoint@1}>;
			};
			endpoint@5 {
				reg = <0x05>;
				remote-endpoint = <&{/syscon@fdc60000/lvds1/ports/port@0/endpoint@0}>;
			};
		};
		port@2 {
			rockchip,primary-plane = <0x03>;
			rockchip,plane-mask = <0x08>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x02>;
			endpoint@0 {
				reg = <0x00>;
				remote-endpoint = <&{/syscon@fdc60000/lvds/ports/port@0/endpoint@2}>;
			};
			endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&{/syscon@fdc60000/rgb/ports/port@0/endpoint@2}>;
			};
			endpoint@2 {
				reg = <0x02>;
				remote-endpoint = <&{/syscon@fdc60000/lvds1/ports/port@0/endpoint@1}>;
			};
		};
	};
};

&vop_mmu {
	status = "okay";
};

&hdmi {
	rockchip,grf = <&grf>;
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/hdmitx/hdmitx-scl} &{/pinctrl/hdmitx/hdmitx-sda} &{/pinctrl/hdmitx/hdmitxm0-cec}>;
	status = "okay";
	ports {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		port@0 {
			reg = <0x00>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			endpoint@0 {
				reg = <0x00>;
				remote-endpoint = <&{/vop@fe040000/ports/port@0/endpoint@3}>;
				status = "okay";
			};
			endpoint@1 {
				reg = <0x01>;
				remote-endpoint = <&{/vop@fe040000/ports/port@1/endpoint@3}>;
				status = "disabled";
			};
		};
	};
};

&sdmmc2 {
	max-frequency = <0xbebc200>;
	status = "okay";
	bus-width = <0x04>;
	mmc-pwrseq = <0xa8>;
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/sdmmc2/sdmmc2m0-bus4} &{/pinctrl/sdmmc2/sdmmc2m0-cmd} &{/pinctrl/sdmmc2/sdmmc2m0-clk}>;
};

&pcie2x1 {
	num-lanes = <0x01>;
	status = "okay";
	reset-gpios = <&gpio3 0x11 0x00>;
	disable-gpios = <&gpio3 0x12 0x00>;
	vpcie3v3-supply = <0xb7>;
};

&pcie3x1 {
	num-lanes = <0x01>;
	status = "disabled";
};

&pcie3x2 {
	num-lanes = <0x02>;
	status = "okay";
	reset-gpios = <&gpio2 0x1e 0x00>;
	vpcie3v3-supply = <0xbc>;
};

&gmac0 {
	rockchip,grf = <&grf>;
	status = "okay";
	phy-mode = "rgmii";
	clock_in_out = "output";
	snps,reset-gpio = <&gpio2 &{/vop@fe040000/ports/port@1/endpoint@4} &{/interrupt-controller@fd400000}>;
	snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/gmac0/gmac0-miim} &{/pinctrl/gmac0/gmac0-tx-bus2} &{/pinctrl/gmac0/gmac0-rx-bus2} &{/pinctrl/gmac0/gmac0-rgmii-clk} &{/pinctrl/gmac0/gmac0-rgmii-bus}>;
	tx_delay = <0x21>;
	rx_delay = <0x3c>;
	phy-handle = <&{/ethernet@fe2a0000/mdio/phy@0}>;
	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0x00>;
		};
	};
	rx-queues-config {
		snps,rx-queues-to-use = <0x01>;
	};
	tx-queues-config {
		snps,tx-queues-to-use = <0x01>;
	};
};

&sdmmc0 {
	max-frequency = <0x8f0d180>;
	status = "okay";
	bus-width = <0x04>;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/sdmmc0/sdmmc0-bus4} &{/pinctrl/sdmmc0/sdmmc0-clk} &{/pinctrl/sdmmc0/sdmmc0-cmd} &{/pinctrl/sdmmc0/sdmmc0-det}>;
};

