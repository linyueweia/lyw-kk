&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&{/pinctrl/i2c4/i2c4m0-xfer}>;
	status = "okay";
	gc5035@37 {
		compatible = "galaxycore,gc5035";
		status = "okay";
		reg = <0x37>;
		clocks = <&pmucru &{/pinctrl/i2s3/i2s3m0-lrck}>;
		clock-names = "xvclk";
		power-domains = <&{/power-management@fdd90000/power-controller} 0x08>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/cif/cif-clk}>;
		reset-gpios = <&gpio0 0x0f 0x00>;
		pwdn-gpios = <&gpio1 &{/vop@fe040000/ports/port@0/endpoint@2} 0x00>;
		rockchip,camera-module-index = <0x00>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "default";
		rockchip,camera-module-lens-name = "PC5322-M5";
		port {
			endpoint {
				remote-endpoint = <0xec>;
				data-lanes = <0x01 0x02>;
			};
		};
	};
};

