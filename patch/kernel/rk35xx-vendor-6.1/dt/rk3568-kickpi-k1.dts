	display-subsystem {
		compatible = "rockchip,display-subsystem";
		memory-region = <&drm_logo &drm_cubic_lut>;
		memory-region-names = "drm-logo\0drm-cubic-lut";
		ports = <&{/vop@fe040000/ports}>;
		devfreq = <&{/dmc}>;
		route {
			route-dsi0 {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&{/vop@fe040000/ports/port@0/endpoint@0}>;
			};
			route-dsi1 {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&{/vop@fe040000/ports/port@0/endpoint@1}>;
			};
			route-edp {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&{/vop@fe040000/ports/port@0/endpoint@2}>;
			};
			route-hdmi {
				status = "okay";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&{/vop@fe040000/ports/port@0/endpoint@3}>;
			};
			route-lvds {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&{/vop@fe040000/ports/port@1/endpoint@4}>;
			};
			route-lvds1 {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&{/vop@fe040000/ports/port@2/endpoint@2}>;
			};
			route-rgb {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <&{/vop@fe040000/ports/port@2/endpoint@1}>;
			};
		};
	};
	external-gmac0-clock {
		compatible = "fixed-clock";
		clock-frequency = <0x7735940>;
		clock-output-names = "gmac0_clkin";
		#clock-cells = <0x00>;
	};
	external-gmac1-clock {
		compatible = "fixed-clock";
		clock-frequency = <0x7735940>;
		clock-output-names = "gmac1_clkin";
		#clock-cells = <0x00>;
	};
	xpcs-gmac0-clock {
		compatible = "fixed-clock";
		clock-frequency = <0x7735940>;
		clock-output-names = "clk_gmac0_xpcs_mii";
		#clock-cells = <0x00>;
	};
	xpcs-gmac1-clock {
		compatible = "fixed-clock";
		clock-frequency = <0x7735940>;
		clock-output-names = "clk_gmac1_xpcs_mii";
		#clock-cells = <0x00>;
	};
	i2s1-mclkin-rx {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbb8000>;
		clock-output-names = "i2s1_mclkin_rx";
	};
	i2s1-mclkin-tx {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbb8000>;
		clock-output-names = "i2s1_mclkin_tx";
	};
	i2s2-mclkin {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbb8000>;
		clock-output-names = "i2s2_mclkin";
	};
	i2s3-mclkin {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbb8000>;
		clock-output-names = "i2s3_mclkin";
	};
	mpll {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x2faf0800>;
		clock-output-names = "mpll";
	};
	xin24m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "xin24m";
	};
	xin32k {
		compatible = "fixed-clock";
		clock-frequency = <0x8000>;
		clock-output-names = "xin32k";
		#clock-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&{/pinctrl/clk32k/clk32k-out0}>;
	};
	pinctrl {
		compatible = "rockchip,rk3568-pinctrl";
		rockchip,grf = <&grf>;
		rockchip,pmu = <&pmugrf>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		/* 5 个 GPIO bank 由 rk356x.dtsi 提供（gpio@…，带 gpio-controller，驱动按此注册）。
		 * 实机转写多复制了一份 gpioN@…（无 gpio-controller、被 pinctrl-rockchip 的 bank match
		 * 跳过），只会产生 5 条 unique_unit_address 重复告警 → 已删除。 */
		pcfg-pull-none-drv-level-1 {
			drive-strength = <0x01>;
		};
		pcfg-pull-none-drv-level-2 {
			drive-strength = <0x02>;
		};
		pcfg-pull-none-drv-level-3 {
			drive-strength = <0x03>;
		};
		pcfg-pull-up-drv-level-1 {
			drive-strength = <0x01>;
		};
		pcfg-pull-up-drv-level-2 {
			drive-strength = <0x02>;
		};
